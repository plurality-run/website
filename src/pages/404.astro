---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<SiteLayout title="Page not found | Plurality" noindex>
  <section class="not-found wrap">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>A connection<br />not quite made.</h1>
    <p class="lead">That page isn&rsquo;t here. Let&rsquo;s get you back to the beginning.</p>
    <a class="button" href="/">Back to Plurality <Arrow direction="right" /></a>
  </section>
</SiteLayout>
