---
import { site } from '../config/site';
import Arrow from './Arrow.astro';
---
<footer class="site-footer wrap">
  <div class="footer-top">
    <a class="brand" href="/" aria-label="Plurality home">
      <img class="brand-lockup" src="/brand/plurality-lockup.svg" width="225" height="78" alt="Plurality" loading="lazy" />
    </a>
    <p>Practical connections.<br />Open possibilities.</p>
    <nav aria-label="Elsewhere">
      <a href={site.links.github}>GitHub <Arrow /></a>
      <a href={site.links.x}>X <Arrow /></a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>&copy; {new Date().getUTCFullYear()} {site.legalName}</span>
    <span>Open infrastructure. Independently operated.</span>
  </div>
</footer>
